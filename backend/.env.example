# ===== DeepSeek-5 ERP — Mühit Konfiqurasiyası Nümunəsi =====
# Bu faylı .env kimi kopyalayın və dəyərləri doldurun.

PORT=5001
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=deepseek_erp_v6
DB_USER=deepseek_admin
DB_PASSWORD=change_me

# JWT
JWT_SECRET=uzun_ve_tesadufi_metn_yaradin
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5174,http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Loglama
LOG_DIR=logs

# ===== AI Provider =====
# AI_MODE=mock (test) | live (real API)
AI_MODE=mock

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5
